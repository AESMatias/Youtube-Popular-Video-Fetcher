---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import { languages, videosByLang, jsonLd } from '../utils/data';

const PREVIEW = 8;
const site = Astro.site ?? 'https://videos.rapidmov.online';
const sections = languages
  .map((lang) => ({ lang, videos: videosByLang(lang.code).slice(0, PREVIEW) }))
  .filter((s) => s.videos.length > 0);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: sections.flatMap((s) => s.videos).map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/videos/${v.slug}`, site).href,
  })),
};

const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'RapidMov', url: new URL('/', site).href };

const pageDescription = "The most popular YouTube videos in every language, ranked and updated weekly by RapidMov.";
---
<Layout title="RapidMov - The most popular YouTube videos by language" description={pageDescription}>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(website)} />
  {sections.length > 0 && <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(itemList)} />}
  <main class="page">
    <div class="hero">
      <h1 class="page-title">What the world is <span class="gradient-text">watching</span></h1>
      <p class="subtitle">The most popular YouTube videos by language, updated weekly.</p>
    </div>

    {sections.length > 0 ? sections.map(({ lang, videos }, s) => (
      <section class="lang-section" lang={lang.code} aria-labelledby={`lang-${lang.code}`}>
        <div class="section-head">
          <h2 id={`lang-${lang.code}`}>{lang.name} <span class="count">{lang.count} videos</span></h2>
          <a href={`/lang/${lang.code}`} class="see-all btn btn-glass btn-sm">See all <span aria-hidden="true">→</span><span class="visually-hidden"> {lang.name} videos</span></a>
        </div>
        <div class="video-grid">
          {videos.map((video, i) => <VideoCard video={video} eager={s === 0 && i < 4} />)}
        </div>
      </section>
    )) : (
      <p class="empty-state">No videos yet. The next data refresh will fill this page, check back soon!</p>
    )}
  </main>
</Layout>

<style>
  .lang-section {
    margin-bottom: var(--space-7);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .section-head h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.65rem);
    letter-spacing: -0.02em;
  }
  .count {
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 31, 31, 0.12);
    color: #ff8a80;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0;
  }
</style>
