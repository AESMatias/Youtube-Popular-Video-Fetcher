---
import Layout from '../../layouts/Layout.astro';
import {
  videoPages, type Video, excerpt, stripMarkdown, plainText, linkify, formatCount, formatDuration, formatDate, languageName, jsonLd,
} from '../../utils/data';

export function getStaticPaths() {
  return videoPages.map((video) => ({ params: { videoSlug: video.slug }, props: { video } }));
}

const { video } = Astro.props as { video: Video };

const pageTitle = video.seo_title || video.title || 'Popular YouTube video';
const summary = video.seo_description ? stripMarkdown(video.seo_description) : '';
const rawDescription = (video.description ?? '').trim();
const descriptionParts = linkify(rawDescription);
// Roughly more than 8 lines, collapse it behind a toggle.
const longDescription = rawDescription.length > 500 || rawDescription.split('\n').length > 8;
const metaDescription = excerpt(plainText(summary || rawDescription), 160) || pageTitle;
const langName = languageName(video.lang);

const views = formatCount(video.view_count);
const likes = formatCount(video.like_count);
const duration = formatDuration(video.duration);
const published = formatDate(video.published_at);
const metaLine = [
  views && `${views} views`,
  likes && `${likes} likes`,
  duration,
  published,
  video.channel_title && `By ${video.channel_title}`,
].filter(Boolean).join(' · ');

const site = 'https://videos.rapidmov.online';
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'RapidMov', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: langName, item: `${site}/lang/${video.lang}` },
    { '@type': 'ListItem', position: 3, name: video.title || pageTitle },
  ],
};
const videoObject = {
  '@type': 'VideoObject',
  name: video.title || pageTitle,
  description: metaDescription,
  thumbnailUrl: video.thumbnail_url || undefined,
  uploadDate: video.published_at || undefined,
  duration: video.duration || undefined,
  embedUrl: `https://www.youtube.com/embed/${video.video_id}`,
  interactionStatistic: {
    '@type': 'InteractionCounter',
    interactionType: { '@type': 'WatchAction' },
    userInteractionCount: video.view_count,
  },
};
const schema = { '@context': 'https://schema.org', '@graph': [breadcrumb, videoObject] };
---

<Layout title={`${pageTitle} - RapidMov`} description={metaDescription} image={video.thumbnail_url || undefined} type="video.other" lang={video.lang}>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(schema)} />
  <main class="container">
    <div class="back-row">
      <a href={`/lang/${video.lang}`} class="back-btn" id="back-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span data-i18n="back">Back</span>
      </a>
    </div>
    <script is:inline>
      // coming from this site: go back to the same scroll spot instead of reloading the list
      document.getElementById('back-btn').addEventListener('click', (e) => {
        if (document.referrer.startsWith(location.origin) && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      });
    </script>
    {video.thumbnail_url && (
      <div class="thumbnail-wrapper">
        <img src={video.thumbnail_url} alt="" aria-hidden="true" class="thumbnail-blur" width="1280" height="720" />
        <img src={video.thumbnail_url} alt={video.title || pageTitle} class="thumbnail" width="1280" height="720" />
      </div>
    )}

    <p class="badges">
      <a href={`/lang/${video.lang}`} class="badge" data-i18n="rankIn" data-i18n-n={video.rank} data-i18n-lang={langName}>#{video.rank} in {langName}</a>
      {video.times_featured > 0 && (
        <span class="badge muted" data-i18n={video.times_featured === 1 ? 'featured1' : 'featured'} data-i18n-n={video.times_featured}>Featured {video.times_featured} {video.times_featured === 1 ? 'time' : 'times'}</span>
      )}
    </p>

    <h1 class="video-title" lang={video.lang}>{pageTitle}</h1>
    {metaLine && <p class="meta-line">{metaLine}</p>}

    <div class="buttons-container">
      <a href={video.youtube_url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
        <span data-i18n="watchOnYt">Watch on YouTube</span>
      </a>
      <a href={`/lang/${video.lang}`} class="btn btn-glass" data-i18n="moreIn" data-i18n-lang={langName}>More in {langName}</a>
    </div>

    {summary && <p class="summary">{summary}</p>}

    {rawDescription && (
      <section class="description-container" aria-labelledby="desc-title">
        <h2 id="desc-title" data-i18n="description">Description</h2>
        {longDescription && <input type="checkbox" id="desc-toggle" class="desc-toggle" />}
        <p id="desc-text" lang={video.lang} class:list={['description-text', { clamped: longDescription }]}>
          {descriptionParts.map((part) =>
            'href' in part
              ? <a href={part.href} target="_blank" rel="nofollow ugc noopener noreferrer" title={part.href}>{part.label}</a>
              : part.text
          )}
        </p>
        {longDescription && (
          <label for="desc-toggle" class="desc-more">
            <span class="more" data-i18n="showMore">Show more</span><span class="less" data-i18n="showLess">Show less</span>
            <svg class="chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </label>
        )}
      </section>
    )}
  </main>
</Layout>

<style>
  main.container {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    padding: 1.5rem 16px;
    box-sizing: border-box;
  }

  .thumbnail-wrapper {
    position: relative;
    width: 100%;
    margin: 0 auto 1.2rem;
  }

  .thumbnail-blur {
    position: fixed;
    top: 40%;
    left: 50%;
    width: 120vw;
    height: auto;
    filter: blur(30px);
    opacity: 0.3;
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: -1;
  }

  .thumbnail {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
  }

  .badge {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .badge.muted {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
  }

  .video-title {
    text-align: center;
    margin: var(--space-4) 0 var(--space-2);
    font-size: clamp(1.2rem, 0.9rem + 1.4vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .meta-line {
    text-align: center;
    font-size: 0.95rem;
    color: var(--color-muted);
    margin: 0 0 var(--space-5);
  }

  .buttons-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: var(--space-6);
  }

  .buttons-container .btn {
    font-size: 1.05rem;
    padding: 0.85rem 1.8rem;
    min-width: 200px;
  }

  .summary {
    color: var(--color-soft);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 var(--space-5);
  }

  .description-container {
    color: var(--color-soft);
    line-height: 1.6;
    background: rgba(23, 23, 28, 0.72);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    padding: var(--space-5);
    border-radius: var(--radius);
  }

  .description-container h2 {
    margin: 0 0 var(--space-3);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .description-text {
    margin: 0;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .description-text a {
    color: #ff8a80;
    text-decoration: underline;
    text-decoration-color: rgba(255, 138, 128, 0.4);
    text-underline-offset: 3px;
  }

  .description-text a:hover {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .back-row {
    width: 100%;
    margin-bottom: var(--space-4);
    text-align: left;
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.95rem 0.5rem 0.7rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.15s ease;
  }
  .back-btn:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .back-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Collapsed text stays in the DOM, so screen readers still get all of it. */
  .clamped {
    max-height: 13.5em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent);
    mask-image: linear-gradient(to bottom, #000 65%, transparent);
  }

  .desc-toggle:checked ~ .clamped {
    max-height: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .desc-toggle {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .desc-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: min(100%, 340px);
    margin: var(--space-4) auto 0;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    user-select: none;
  }

  .desc-more:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .chevron {
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.2s ease;
  }

  .desc-more:hover .chevron,
  .desc-toggle:focus-visible ~ .desc-more .chevron {
    opacity: 1;
  }

  .desc-toggle:checked ~ .desc-more .chevron {
    transform: rotate(180deg);
  }

  /* No hover on touch screens, so keep the arrow visible there. */
  @media (hover: none) {
    .chevron {
      opacity: 1;
    }
  }

  .desc-toggle:focus-visible ~ .desc-more {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .less,
  .desc-toggle:checked ~ .desc-more .more {
    display: none;
  }

  .desc-toggle:checked ~ .desc-more .less {
    display: inline;
  }

  @media (max-width: 600px) {
    .buttons-container .btn {
      width: 100%;
      max-width: 320px;
      min-width: 0;
      font-size: 1rem;
    }
  }
</style>
