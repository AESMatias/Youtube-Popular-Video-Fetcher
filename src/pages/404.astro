---
import Layout from '../layouts/Layout.astro';
---

<Layout noindex title="Page not found - RapidMov" description="This page does not exist. Popular videos change every day.">
  <main>
    <h1>404 - Page not found</h1>
    <p>This video or page is not here anymore. Popular videos change every day!</p>
    <p><a href="/" class="btn btn-primary">Back to popular videos</a></p>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 2rem 16px;
    text-align: center;
  }
  h1 {
    color: var(--color-primary);
  }
  p {
    color: #ccc;
  }
</style>
